{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index?__path=/api"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index?__path=/api/:path*"
    }
  ],
  "functions": {
    "api/index.go": {
      "maxDuration": 30
    }
  }
}
